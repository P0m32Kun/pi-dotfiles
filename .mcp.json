{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "lifecycle": "lazy"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "lifecycle": "lazy"
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve"],
      "lifecycle": "lazy"
    },
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble"],
      "lifecycle": "lazy"
    },
    "agentmemory": {
      "command": "npx",
      "args": ["@agentmemory/agentmemory", "serve"],
      "lifecycle": "lazy"
    }
  }
}
