{
  "enabled": true,
  "maxConcurrent": 4,
  "timeout": 300000,
  "defaultMode": "single",
  "agents": {
    "coder": {
      "capabilities": ["code", "implement"],
      "model": null
    },
    "tester": {
      "capabilities": ["test", "verify"],
      "model": null
    },
    "reviewer": {
      "capabilities": ["review", "analyze"],
      "model": null
    }
  },
  "decomposition": {
    "enabled": true,
    "strategies": ["code-module", "feature", "test"]
  },
  "aggregation": {
    "enabled": true,
    "combineOutputs": true
  }
}
